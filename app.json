{
  "expo": {
    "name": "TruePas",
    "slug": "truepas-app",
    "version": "1.0.8",
    "orientation": "portrait",
    "icon": "./assets/images/truepas-app-icon.png",
    "scheme": "truepasapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.truepas.truepasapp",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "NSCameraUsageDescription": "Camera is required for document scanning and face recognition",
        "NSPhotoLibraryUsageDescription": "Photo library access is needed to select documents",
        "NSFaceIDUsageDescription": "Face ID is used to securely authenticate your identity"
      }
    },
    "android": {
      "package": "com.truepas.truepasapp",
      "versionCode": 2,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/truepas-adaptive-foreground.png",
        "monochromeImage": "./assets/images/truepas-adaptive-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/truepas-favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "sitemap": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/truepas-splash.png",
          "imageWidth": 76
        }
      ],
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Camera is required for document scanning and face recognition",
          "microphonePermission": "TruePas does not record audio. This permission is required by the camera component.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "16.4"
          },
          "android": {
            "minSdkVersion": 29,
            "allowBackup": false
          }
        }
      ],
      "./plugins/withRegulaMaven",
      "./plugins/withRegulaLicense"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e1b66378-7754-4354-89d4-633ca8e89ebe"
      }
    },
    "owner": "facepeai"
  }
}
